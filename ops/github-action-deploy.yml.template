name: Deploy to Cloudflare

# Deploys the archive Worker whenever an issue or the Worker code changes on main.
# The weekly cloud routine generates a new issue and pushes; this Action publishes it.
# Requires repo secret CLOUDFLARE_API_TOKEN (account: achretien22, "Edit Cloudflare Workers").

on:
  push:
    branches: [master, main]
    paths:
      - 'issues/**'
      - 'src/**'
      - 'wrangler.toml'
      - '.github/workflows/deploy.yml'
  workflow_dispatch: {}

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: npm install
      - run: npm run build
      - name: Deploy
        run: npx wrangler deploy
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
